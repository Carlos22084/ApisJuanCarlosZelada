APP_NAME="A&A Multiservicios"
APP_ENV=production
APP_KEY=__GENERATED_APP_KEY__
APP_DEBUG=false
APP_URL=https://TU-SUBDOMINIO.infinityfreeapp.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=HOST_MYSQL_DE_INFINITYFREE
DB_PORT=3306
DB_DATABASE=NOMBRE_BD_DE_INFINITYFREE
DB_USERNAME=USUARIO_MYSQL_DE_INFINITYFREE
DB_PASSWORD=CONTRASENA_MYSQL_DE_INFINITYFREE

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DESIGNS_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="pedidos@su-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
RESEND_NOTIFICATIONS_ENABLED=false

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_AI_WIDTH=1024
CLOUDFLARE_AI_HEIGHT=1024

VITE_APP_NAME="${APP_NAME}"
